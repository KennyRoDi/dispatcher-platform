FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg procps && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN useradd --uid 10001 --create-home appuser && mkdir -p /scratch && chown appuser /scratch
USER 10001
ENV TMPDIR=/scratch PYTHONDONTWRITEBYTECODE=1
