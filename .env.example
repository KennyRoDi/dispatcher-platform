# <IP_TAILSCALE_NODO_A>: salida de `tailscale ip -4` en el Nodo A. Reemplazar antes de usar.
# Los contenedores del Nodo A ignoran estos valores: su Compose usa los nombres de servicio.

# Redis
REDIS_HOST=<IP_TAILSCALE_NODO_A>
REDIS_PORT=6380
REDIS_PASSWORD=

# Coordinador
COORDINATOR_URL=https://<IP_TAILSCALE_NODO_A>:8443

# Autenticacion (F-26). `python -m scripts.generar_credenciales` rellena estas tres variables sin imprimirlas.
# JWT_SECRET: solo en el Nodo A (el coordinador lo usa para verificar). Minimo 32 bytes; nunca en un nodo worker.
JWT_SECRET=
# WORKER_TOKEN: token de rol "servicio" con el que cada worker reporta sub-tareas. Va en el .env de cada nodo worker.
# Vence segun --dias; al vencer los reportes dan 401. Para copiar solo este valor: --solo-worker <archivo>.
WORKER_TOKEN=
# API_TOKEN: token de rol "administrador" para scripts (submit_case, run_load, ...) y el dashboard. No en los workers.
API_TOKEN=

# MinIO
MINIO_ENDPOINT=<IP_TAILSCALE_NODO_A>:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=true
DATASET_BUCKET=dataset
RESULTS_BUCKET=results
# Imagen del servidor MinIO (solo maquina A). Vacio: cgr.dev/chainguard/minio:latest
MINIO_IMAGE=

# TLS entre nodos (F-27). Activo por defecto; TLS_ENABLED=false solo en deploy/docker-compose.local.yml.
TLS_ENABLED=true
# Ruta de ca.pem (solo la CA publica) en esta maquina; el Compose de worker la monta en el contenedor.
TLS_CA_FILE=<RUTA_A_ca.pem>
# Solo en el Nodo A: carpeta con los certificados que crea deploy/tls/generar_certs.sh. Fuera del repo.
# CERTS_DIR=$HOME/.ms-certs
# UID y GID del usuario que genero los certificados (`id -u`, `id -g`): Redis y MinIO corren con ellos para leer server.key 0600.
CERTS_UID=
CERTS_GID=

# Identidad del nodo
# NODE_NAME: obligatorio en Docker. Salida de `hostname` en la maquina; debe ser unico entre nodos.
# Compose lo fija como hostname del contenedor y aparece como "host" y "hostname" en GET /workers.
NODE_NAME=
# NODE_IP: obligatorio en Docker. Salida de `tailscale ip -4` en esta maquina.
# En los workers es la "ip" del heartbeat; en el Nodo A, la interfaz donde se publican los puertos.
NODE_IP=
# WORKER_ID vacio: se genera como "worker-<hostname>", unico por nodo
WORKER_ID=
WORKER_QUEUES=transcode_video,extract_audio,generate_thumbnail,convert_audio,extract_metadata
WORKER_CONCURRENCY=2
# WORKER_MEM_LIMIT: limite explicito de memoria por worker, por ejemplo 4g.
# Debe calibrarse con una medicion real; el preflight rechazara un presupuesto excesivo.
WORKER_MEM_LIMIT=
# WORK_DIR vacio: carpeta temporal del sistema (la imagen Docker usa /tmp/mm-worker)
WORK_DIR=
# FFMPEG_TIMEOUT vacio: rige el default del procesador (600 s; proporcional a la duracion en P2)
FFMPEG_TIMEOUT=
# Presupuesto de admision (obligatorio desde F-17; sin valor por defecto: medir segun M1 §4.1; sin medir el worker no arranca)
# y se reinicia en bucle. No inventar valores.
ADMISSION_MARGIN_BYTES=
FOOTPRINT_TRANSCODE_VIDEO_BYTES=
FOOTPRINT_EXTRACT_AUDIO_BYTES=
FOOTPRINT_GENERATE_THUMBNAIL_BYTES=
FOOTPRINT_CONVERT_AUDIO_BYTES=
FOOTPRINT_EXTRACT_METADATA_BYTES=
# HWACCEL: solo en el nodo GPU poner "nvenc" (transcode_video usa NVENC, con fallback a CPU). Vacio en los demas.
HWACCEL=

# Reaper (recuperacion de sub-tareas colgadas)
HEARTBEAT_INTERVAL=5.0
HEARTBEAT_TTL=15
REAPER_INTERVAL=10.0
REAPER_MAX_AGE=2100.0
MAX_ATTEMPTS=3
# F-11: espera entre reintentos de una sub-tarea (backoff exponencial con jitter), en segundos. Provisionales, sin medir.
RETRY_BASE_S=1
RETRY_CAP_S=30

# F-23: almacenamiento de objetos y staging compartido del coordinador
OBJECTS_BUCKET=objetos
MINIO_SECURE=false
STAGING_DIR=/var/lib/dispatcher/staging
# KEK_FILE: ruta, en ESTA maquina, de la KEK (32 bytes, modo 0400 o 0600, fuera del repositorio). Los Compose del Nodo A y de los
# workers de analisis la montan de solo lectura; sin KEK el cifrado falla cerrado. Mismo valor binario en los tres nodos worker
# y en el Nodo A (SUP-30). Procedimiento: docs/DEPLOY_WORKERS.md §10.
KEK_FILE=

# F-29: ruta del archivo con la llave de custodia (32 bytes, 0400/0600, fuera del repo, distinta de la KEK de F-28)
CUSTODY_KEY_FILE=

# F-43: workers de analisis tipados (deploy/docker-compose.analisis.yml). Ver docs/DEPLOY_WORKERS.md §10.
# COMPOSE_PROFILES: tipos que corre ESTE nodo, separados por coma (texto, imagen, audio). Cada tipo en al menos dos nodos.
COMPOSE_PROFILES=
# WORKER_KIND lo fija el Compose por servicio (text, image o audio); no se define aqui.
# Memoria por tipo, sin valor por defecto. Compose exige las tres, tambien las del tipo que el nodo no corre.
# Medir segun M1; no inventar valores (Medicion pendiente).
WORKER_MEM_LIMIT_TEXT=
WORKER_MEM_LIMIT_IMAGE=
WORKER_MEM_LIMIT_AUDIO=
# Huella de memoria por tipo (bytes), sin valor por defecto. ADMISSION_MARGIN_BYTES es el de arriba. Medicion pendiente.
FOOTPRINT_TEXT_BYTES=
FOOTPRINT_IMAGE_BYTES=
FOOTPRINT_AUDIO_BYTES=
# Muestreo de video (SUP-48, provisional, sin medir): un fotograma cada FRAME_EVERY_S segundos, como maximo FRAME_MAX.
# Si se omiten, el Compose usa 5 y 20.
FRAME_EVERY_S=
FRAME_MAX=
# Dentro del contenedor, el Compose fija CONFIG_DIR=/app/config, YOLO_WEIGHTS_DIR=/models/yolo y la cache de
# HuggingFace en /models/huggingface (volumen "modelos"). No hace falta definirlos aqui.
