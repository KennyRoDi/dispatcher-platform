# <IP_TAILSCALE_NODO_A>: salida de `tailscale ip -4` en el Nodo A. Reemplazar antes de usar.
# Los contenedores del Nodo A ignoran estos valores: su Compose usa los nombres de servicio.

# Redis
REDIS_HOST=<IP_TAILSCALE_NODO_A>
REDIS_PORT=6379
REDIS_PASSWORD=

# Coordinador
COORDINATOR_URL=http://<IP_TAILSCALE_NODO_A>:8000

# MinIO
MINIO_ENDPOINT=<IP_TAILSCALE_NODO_A>:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
DATASET_BUCKET=dataset
RESULTS_BUCKET=results
# Imagen del servidor MinIO (solo maquina A). Vacio: cgr.dev/chainguard/minio:latest
MINIO_IMAGE=

# Identidad del nodo
# NODE_NAME: obligatorio en Docker. Salida de `hostname` en la maquina; debe ser unico entre nodos.
# Compose lo fija como hostname del contenedor y aparece como "host" y "hostname" en GET /workers.
NODE_NAME=
# NODE_IP: obligatorio en Docker. Salida de `tailscale ip -4` en esta maquina.
# En los workers es la "ip" del heartbeat; en el Nodo A, la interfaz donde se publican los puertos.
NODE_IP=
# WORKER_ID vacio: se genera como "worker-<hostname>", unico por nodo
WORKER_ID=
WORKER_QUEUES=transcode_video,extract_audio,generate_thumbnail,convert_audio,extract_metadata
WORKER_CONCURRENCY=2
# WORKER_MEM_LIMIT: limite explicito de memoria por worker, por ejemplo 4g.
# Debe calibrarse con una medicion real; el preflight rechazara un presupuesto excesivo.
WORKER_MEM_LIMIT=
# WORK_DIR vacio: carpeta temporal del sistema (la imagen Docker usa /tmp/mm-worker)
WORK_DIR=
# FFMPEG_TIMEOUT vacio: rige el default del procesador (600 s; proporcional a la duracion en P2)
FFMPEG_TIMEOUT=
# Presupuesto de admision (obligatorio desde F-17; sin valor por defecto: medir segun M1 §4.1; sin medir el worker no arranca)
# y se reinicia en bucle. No inventar valores.
ADMISSION_MARGIN_BYTES=
FOOTPRINT_TRANSCODE_VIDEO_BYTES=
FOOTPRINT_EXTRACT_AUDIO_BYTES=
FOOTPRINT_GENERATE_THUMBNAIL_BYTES=
FOOTPRINT_CONVERT_AUDIO_BYTES=
FOOTPRINT_EXTRACT_METADATA_BYTES=
# HWACCEL: solo en el nodo GPU poner "nvenc" (transcode_video usa NVENC, con fallback a CPU). Vacio en los demas.
HWACCEL=

# Reaper (recuperacion de sub-tareas colgadas)
HEARTBEAT_INTERVAL=5.0
HEARTBEAT_TTL=15
REAPER_INTERVAL=10.0
REAPER_MAX_AGE=2100.0
MAX_ATTEMPTS=3
